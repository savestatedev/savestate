{
  "version": 2,
  "outputDirectory": "site",
  "buildCommand": "npx ts-node scripts/generate-blog-index.ts",
  "redirects": [
    { "source": "/pricing", "destination": "/#pricing", "permanent": false },
    { "source": "/login", "destination": "/dashboard", "permanent": false }
  ],
  "rewrites": [
    { "source": "/v1/keys", "destination": "/api/v1/keys" },
    { "source": "/v1/keys/claims/:id", "destination": "/api/v1/keys/claims/:id" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/cursor", "destination": "/cursor.html" },
    { "source": "/claude-code", "destination": "/claude-code.html" },
    { "source": "/clawdbot", "destination": "/clawdbot.html" },
    { "source": "/when-the-thread-dies", "destination": "/when-the-thread-dies.html" },
    { "source": "/mcp", "destination": "/mcp.html" },
    { "source": "/agent-memory", "destination": "/agent-memory.html" },
    { "source": "/codex", "destination": "/codex.html" },
    { "source": "/gemini", "destination": "/gemini.html" },
    { "source": "/chatgpt", "destination": "/chatgpt.html" },
    { "source": "/openai", "destination": "/openai.html" },
    { "source": "/claude", "destination": "/claude.html" },
    { "source": "/windsurf", "destination": "/windsurf.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/when-the-chat-dies", "destination": "/blog/when-the-chat-dies.html" },
    { "source": "/blog/your-ai-knows-everything", "destination": "/blog/your-ai-knows-everything.html" },
    { "source": "/blog/how-savestate-works", "destination": "/blog/how-savestate-works.html" },
    { "source": "/blog/the-great-ai-memory-crisis", "destination": "/blog/the-great-ai-memory-crisis.html" },
    { "source": "/blog/savestate-architecture-deep-dive", "destination": "/blog/savestate-architecture-deep-dive.html" },
    { "source": "/blog/migrate-chatgpt-to-claude", "destination": "/blog/migrate-chatgpt-to-claude.html" },
    { "source": "/blog/why-ai-needs-backup", "destination": "/blog/why-ai-needs-backup.html" },
    { "source": "/blog/building-custom-adapters", "destination": "/blog/building-custom-adapters.html" }
  ],
  "trailingSlash": false,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/.well-known/mcp.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/mcp.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/agents.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
